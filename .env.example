# MCPilot Environment Configuration
# Copy this file to .env and fill in your values

# App
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-production
# Optional: static key granting admin scope. Leave empty to disable.
ADMIN_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/mcpilot

# LLM Provider (ollama | anthropic)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Contact form submissions (stored on local disk)
CONTACT_SUBMISSIONS_DIR=data/contact_submissions

# Data Retention (days)
AUDIT_LOG_RETENTION_DAYS=2555
PII_DATA_RETENTION_DAYS=365

# Data Controller (GDPR/DPDP)
DATA_CONTROLLER_NAME=MCPilot Technologies
DATA_CONTROLLER_CONTACT=privacy@mcpilot.in
